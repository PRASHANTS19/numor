generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model Organization {
  id            BigInt        @id @default(autoincrement())
  name          String        @db.Citext
  email         String        @unique @db.Citext
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  taxId         String?
  logoUrl       String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expenses      ExpenseBill[]
  invoices      InvoiceBill[]
  kpis          KpiSnapshot[]
  users         User[]

  @@map("organizations")
}

model User {
  id           BigInt        @id @default(autoincrement())
  orgId        BigInt
  userType     String
  email        String        @unique @db.Citext
  isEmailVerified Boolean       @default(false)
  name         String        @db.Citext
  phone        String?
  address      String?
  profilePhotoKey String?
  passwordHash String?
  authProvider AuthProvider  @default(LOCAL)
  googleId     String?       @unique
  role         Role          @default(SME_USER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resetPasswordToken      String?
  resetPasswordExpiresAt  DateTime?
  
  caBookings   CABooking[]
  caProfile    CAProfile?
  caReviews    CAReview[]
  clients      Client[]
  expenses     ExpenseBill[]
  invoices     InvoiceBill[]
  organization Organization  @relation(fields: [orgId], references: [id])

  @@map("users")
}

model Client {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt
  name          String        @db.Citext
  email         String?       @db.Citext
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  gstin         String?
  country       String?
  companyType   String?
  taxId         String?
  taxSystem     TaxSystem     @default(NONE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  invoices      InvoiceBill[]

  @@unique([userId, name])
  @@index([userId])
  @@map("clients")
}

model InvoiceBill {
  id                   BigInt            @id @default(autoincrement())
  orgId                BigInt
  clientId             BigInt?
  customerId           BigInt
  invoiceNumber        String
  invoiceType          String            @default("TAX")
  issueDate            DateTime
  dueDate              DateTime
  paymentTerms         String?
  currency             String            @default("USD")
  exchangeRate         Decimal?          @db.Decimal(10, 4)
  baseCurrency         String?           @default("INR")
  baseAmount           Decimal?          @db.Decimal(15, 2)
  subtotal             Decimal           @default(0.00) @db.Decimal(15, 2)
  discount             Decimal           @default(0.00) @db.Decimal(15, 2)
  taxAmount            Decimal           @default(0.00) @db.Decimal(15, 2)
  shippingCost         Decimal           @default(0.00) @db.Decimal(15, 2)
  totalAmount          Decimal           @db.Decimal(15, 2)
  paidAmount           Decimal           @default(0.00) @db.Decimal(15, 2)
  balanceDue           Decimal           @default(0.00) @db.Decimal(15, 2)
  effectiveTax         Decimal?          @default(0.00)
  status               String            @default("UNPAID")
  category             String            @default("OTHER")
  pdfKey               String?
  sentAt               DateTime?
  paidAt               DateTime?
  sellerName           String?           @db.Citext
  sellerStreetAddress  String?
  sellerCity           String?
  sellerState          String?
  sellerZipCode        String?
  sellerCountry        String?
  sellerEmail          String?           @db.Citext
  sellerPhone          String?
  sellerTaxId          String?
  iecCode              String?
  lutFiled             Boolean           @default(false)
  taxType              String            @default("NONE")
  placeOfSupply        String?
  reverseCharge        Boolean           @default(false)
  reverseReason        String?
  sacCode              String?
  taxSummary           Json?
  shipToName           String?
  shipToAddress        String?
  countryOfOrigin      String?
  countryOfDestination String?
  incoterms            String?
  bankDetails          Json?
  paymentLink          String?
  bankAddress          String?
  jurisdiction         String?
  lateFeePolicy        String?
  notes                String?
  pdfStatus            String            @default("NOT_STARTED")
  confirmedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  items                InvoiceBillItem[]
  client               Client?           @relation(fields: [clientId], references: [id])
  customer             User              @relation(fields: [customerId], references: [id])
  organization         Organization      @relation(fields: [orgId], references: [id])

  @@index([clientId])
  @@map("invoice_bills")
}

model InvoiceBillItem {
  id          BigInt      @id @default(autoincrement())
  invoiceId   BigInt
  itemName    String
  description String?
  quantity    Decimal     @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(15, 2)
  taxRate     Decimal     @default(0.00) @db.Decimal(15, 2)
  totalPrice  Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  unitType    String?     @default("UNIT")
  invoice     InvoiceBill @relation(fields: [invoiceId], references: [id])

  @@map("invoice_bill_items")
}

model ExpenseBill {
  id            BigInt            @id @default(autoincrement())
  orgId         BigInt
  userId        BigInt?
  merchant      String?
  expenseDate   DateTime
  totalAmount   Decimal           @db.Decimal(15, 2)
  category      String            @default("OTHER")
  paymentMethod String?
  receiptUrl    String?
  ocrExtracted  Boolean           @default(false)
  ocrConfidence Decimal?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  totalTax      Decimal?          @default(0.00) @db.Decimal(15, 2)
  items         ExpenseBillItem[]
  organization  Organization      @relation(fields: [orgId], references: [id])
  user          User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@map("expense_bills")
}

model ExpenseBillItem {
  id         BigInt      @id @default(autoincrement())
  expenseId  BigInt
  itemName   String?
  quantity   Decimal     @default(1) @db.Decimal(15, 2)
  unitPrice  Decimal     @db.Decimal(15, 2)
  totalPrice Decimal     @db.Decimal(15, 2)
  createdAt  DateTime    @default(now())
  taxRate    Decimal     @default(0.00) @db.Decimal(15, 2)
  unitType   String?     @default("UNIT")
  expense    ExpenseBill @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_bill_items")
}

model KpiSnapshot {
  id                     BigInt       @id @default(autoincrement())
  orgId                  BigInt
  snapshotDate           DateTime
  totalIncome            Decimal      @default(0.00) @db.Decimal(15, 2)
  totalExpenses          Decimal      @default(0.00) @db.Decimal(15, 2)
  netCashflow            Decimal      @default(0.00) @db.Decimal(15, 2)
  outstandingReceivables Decimal      @default(0.00) @db.Decimal(15, 2)
  overdueInvoicesCount   Int          @default(0)
  topExpenseCategory     String?
  expenseGrowthPercent   Decimal?     @db.Decimal(15, 2)
  createdAt              DateTime     @default(now())
  organization           Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, snapshotDate])
  @@map("kpi_snapshots")
}

model CAProfile {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @unique
  registrationNo  String        @unique
  experienceYears Int
  hourlyFee       Decimal       @db.Decimal(10, 2)
  bio             String?
  profilePhotoKey String?  
  languages       String[]
  specializations String[]
  type            String
  calendlyUrl     String?
  calComUrl       String?
  zoomEmail       String?       @db.Citext
  whatsappNumber  String?
  status          CAStatus      @default(PENDING)  //PENDING APPROVED REJECTED SUSPENDED UNDER_REVIEW
  ratingAvg       Decimal?      @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  streetAddress String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents       CADocument[] 
  analytics       CAAnalytics[]
  bookings        CABooking[]
  user            User          @relation(fields: [userId], references: [id])
  reviews         CAReview[]
  slots           CASlot[]

  @@map("ca_profiles")
}

model CADocument {
  id         BigInt   @id @default(autoincrement())
  caProfileId BigInt
  type       CADocumentType
  fileKey    String
  description String?
  createdAt  DateTime @default(now())

  caProfile  CAProfile @relation(fields: [caProfileId], references: [id])

  @@map("ca_documents")
}

enum CADocumentType {
  CERTIFICATION
  ID_PROOF
}

model CABooking {
  id               BigInt           @id @default(autoincrement())
  bookingCode      String           @unique
  userId           BigInt
  caProfileId      BigInt
  slotId           BigInt           @unique
  consultationMode ConsultationMode
  scheduledAt      DateTime
  durationMinutes  Int              @default(60)
  meetingLink      String?
  meetingProvider  String?
  amount           Decimal          @db.Decimal(15, 2)
  currency         String           @default("INR")
  status           BookingStatus    @default(INITIATED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  caProfile        CAProfile        @relation(fields: [caProfileId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  payment          CAPayment?
  review           CAReview?
  slot             CASlot?          @relation("CASlotToBooking")

  @@index([userId])
  @@index([caProfileId])
  @@map("ca_bookings")
}

model CAPayment {
  id               BigInt        @id @default(autoincrement())
  bookingId        BigInt        @unique
  gateway          String
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Decimal       @db.Decimal(15, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          CABooking     @relation(fields: [bookingId], references: [id])

  @@map("ca_payments")
}

model CAReview {
  id          BigInt    @id @default(autoincrement())
  bookingId   BigInt    @unique
  caProfileId BigInt
  userId      BigInt
  rating      Int
  comment     String?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  booking     CABooking @relation(fields: [bookingId], references: [id])
  caProfile   CAProfile @relation(fields: [caProfileId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([caProfileId])
  @@map("ca_reviews")
}

model CAAnalytics {
  id            BigInt    @id @default(autoincrement())
  caProfileId   BigInt
  snapshotDate  DateTime
  profileViews  Int       @default(0)
  bookingsCount Int       @default(0)
  earnings      Decimal   @db.Decimal(15, 2)
  caProfile     CAProfile @relation(fields: [caProfileId], references: [id])

  @@unique([caProfileId, snapshotDate])
  @@map("ca_analytics_snapshots")
}

model CASlot {
  id          BigInt     @id @default(autoincrement())
  caProfileId BigInt
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  status      SlotStatus @default(AVAILABLE)
  bookingId   BigInt?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  booking     CABooking? @relation("CASlotToBooking", fields: [bookingId], references: [id])
  caProfile   CAProfile  @relation(fields: [caProfileId], references: [id])

  @@index([caProfileId, date])
  @@index([status])
  @@map("ca_slots")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
}

model checkpoint_migrations {
  v Int @id
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserType {
  INTERNAL
  EXTERNAL
  ADMIN
}

enum Role {
  ADMIN
  SME_USER
  CA_USER
}

enum TaxSystem {
  GST
  VAT
  SALES
  NONE
}

enum CAStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  UNDER_REVIEW
}

enum ConsultationMode {
  VIDEO
  AUDIO
}

enum BookingStatus {
  INITIATED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SlotStatus {
  AVAILABLE
  HOLD
  BOOKED
}
